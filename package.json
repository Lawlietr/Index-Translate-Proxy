    "deploy:vercel": "vercel deploy --prod --yes",
    "env:vercel": "node scripts/set-env-vercel.mjs",
    "probe:timing": "node scripts/probe-sse-timing.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.148.0",
    "vercel": "^63.1.2"
