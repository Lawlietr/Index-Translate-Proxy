  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "test": "node --test 'tests/*.test.mjs'",
    "lint:zh": "node scripts/lint-zh.mjs",
